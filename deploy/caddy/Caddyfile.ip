# =============================================================================
# Caddy — reverse proxy для Logscope (режим: ДОСТУП ПО IP, HTTP)
#
# Используется, когда DOMAIN не задан (пуст). Caddy слушает :80 по HTTP.
# TLS не используется (Let's Encrypt не выдаёт сертификаты на IP-адреса),
# HSTS не ставится (браузер закешировал бы его и блокировал HTTP).
#
# Для доступа по домену (HTTPS) используется отдельный файл Caddyfile.
# Выбор файла — через env CADDY_SUFFIX в docker-compose.prod.yml.
# =============================================================================

:80 {
	# --- Глобальные security-заголовки ---
	header {
		# Запрет MIME-sniffing
		-X-Content-Type-Options "nosniff"
		# Защита от clickjacking
		-X-Frame-Options "DENY"
		# Строгая политика реферера
		-Referrer-Policy "no-referrer"
		# CSP: только собственные ресурсы, inline-стили разрешены (Next.js)
		-Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self'"
		# Запрет индексации
		-X-Robots-Tag "noindex, nofollow"
		# Отключение автоопределения языка/гео
		-X-Permitted-Cross-Domain-Policies "none"
		# HSTS НЕ ставим: доступ по HTTP, браузер закешировал бы HSTS и
		# потом блокировал HTTP-доступ.
	}

	# --- Логирование доступа (JSON, в stdout) ---
	log {
		output stdout
		format json
		level info
	}

	# --- Ограничение размера тела запроса (1 МБ, как в app) ---
	request_body {
		max_size 1MB
	}

	# --- Проксирование на app (внутренняя сеть docker) ---
	reverse_proxy app:3000 {
		# Таймауты, чтобы защитить от медленных клиентов (slowloris)
		transport http {
			read_timeout 30s
			write_timeout 30s
			dial_timeout 5s
		}
	}
}