{
	"name": "logscope",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"dev": "next dev",
		"build": "prisma generate && next build",
		"start": "next start",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"prisma:generate": "prisma generate",
		"prisma:migrate": "prisma migrate dev",
		"prisma:deploy": "prisma migrate deploy",
		"prisma:studio": "prisma studio",
		"test": "tsx --test src/lib/otel/__tests__/*.test.ts"
	},
	"dependencies": {
		"@prisma/client": "^5.22.0",
		"bcryptjs": "^3.0.3",
		"next": "^15.1.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"zod": "^3.24.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@types/bcryptjs": "^2.4.6",
		"@types/node": "^22.10.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"prisma": "^5.22.0",
		"tsx": "^4.19.2",
		"typescript": "^5.7.0"
	}
}
